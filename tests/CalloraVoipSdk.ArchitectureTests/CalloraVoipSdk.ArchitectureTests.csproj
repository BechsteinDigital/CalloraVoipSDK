<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!--
    Consumer-facing assemblies whose exported (public) API surface is gated by
    PublicApiSurfaceTests. These are the two assemblies an external SDK consumer references:
    CalloraVoipSdk.Client (public facade: VoipClient/IVoipClient, WebRtc, Hosting, DI) and
    CalloraVoipSdk.Core (public domain/application/config types reachable through the facade).
    This test project is deliberately NOT in Core's InternalsVisibleTo list, so reflection here
    sees exactly the public surface a real consumer sees.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Client\CalloraVoipSdk.Client.csproj" />
    <ProjectReference Include="..\..\src\Core\CalloraVoipSdk.Core.csproj" />
    <!-- Die Audio-Pakete werden veröffentlicht und waren hier nicht referenziert — weshalb die
         Public-API-Baseline sie nie erfassen KONNTE. Ein Gate sieht nur, was sein Projekt kennt.
         Alle drei, weil alle drei auf nuget.org liegen; dass Audio.Windows unter Linux totes
         Gerät ansteuert, ändert nichts an seiner öffentlichen Fläche. -->
    <ProjectReference Include="..\..\src\Audio\Abstractions\CalloraVoipSdk.Audio.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Audio\Windows\CalloraVoipSdk.Audio.Windows.csproj" />
    <ProjectReference Include="..\..\src\Audio\Linux\CalloraVoipSdk.Audio.Linux.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Approved public-API-surface baseline, copied next to the test binary so the gate can read
       it at runtime (mirrors how the engineering-rule gates locate the repo root / baselines). -->
  <ItemGroup>
    <None Update="PublicApi.approved.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
